# Base URL of the API, including the /v1 prefix.
# Local dev: the API directly. Production: `/v1` (same origin, proxied via API_PROXY_TARGET).
NEXT_PUBLIC_API_URL=http://localhost:3000/v1

# Production only: Next.js rewrites /v1/* to this API origin (keeps the refresh cookie first-party).
# API_PROXY_TARGET=https://chat-api.onrender.com

# Origin for the Socket.IO connection. Required when NEXT_PUBLIC_API_URL is relative;
# defaults to the origin of NEXT_PUBLIC_API_URL otherwise.
# NEXT_PUBLIC_REALTIME_URL=https://chat-api.onrender.com
